---
import type { CollectionEntry } from 'astro:content';
import type { HomepageExample } from '../lib/homepage';
import SectionFrame from './SectionFrame.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { sectionLinks, type SectionKey } from '../lib/sections';
import '../styles/section-page.css';
import { entryPath } from '../lib/editorial-routes';
interface Props { section: SectionKey; preview?: boolean; examples?: HomepageExample; entries?: CollectionEntry<'editorial'>[]; }
const { section, preview = false, examples, entries = [] } = Astro.props;
const first = (kind: CollectionEntry<'editorial'>['data']['kind']) => entries.find(entry => entry.data.kind === kind);
const thought = first('thought');
const perspective = first('perspective');
const question = first('question');
const prefix = preview ? '/design-preview' : '';
const current = sectionLinks.find(item => item.key === section)!;
const ways = ['Suggest a thought or an unanswered question', 'Recommend a perspective', 'Share a practical experience', 'Join an investigation', 'Review a developing publication', 'Suggest a guest for magnus meets'];
---
<BaseLayout title={`${current.label} · tolpagorni thoughts`} preview={preview} activeNav={section === 'participate' || section === 'about' ? section : undefined}>
  <div class="section-page wrap">
    <a class="text-link section-home" href={preview ? '/design-preview' : '/'}>← Home</a>
{section === 'pulse' && <SectionFrame page id="pulse" label="the pulse" note="the rhythm of the house" heading="Always room for something developing">
  <p class="section-intro">What just happened, what is developing, what comes next.</p>
  <ul class="rhythm-strip" aria-label="The editorial rhythm">
    <li><span class="rhythm-mark" aria-hidden="true">·</span><span>a thought<small>fortnightly</small></span></li>
    <li><span class="rhythm-mark" aria-hidden="true">∧</span><span>a perspective<small>monthly</small></span></li>
    <li><span class="rhythm-mark" aria-hidden="true">⋀</span><span>an exploration<small>quarterly</small></span></li>
    <li><span class="rhythm-mark annual" aria-hidden="true">○</span><span>a publication<small>every August</small></span></li>
  </ul>
  {examples ? <div class="pulse-columns">
    <div><h2>just happened <span class="example-label">example</span></h2><p class="meta">a thought</p><p>{examples.thought.title}</p><p class="meta">a perspective</p><p>{examples.perspective.title}</p></div>
    <div><h2>developing now <span class="example-label">example</span></h2><p class="meta">down the rabbit hole</p><p>{examples.investigation.title}</p><p class="meta">an open question</p><p>{examples.question}</p></div>
    <div><h2>comes next</h2><p class="muted">Publication dates will appear here when approved.</p><p class="meta">No example schedule is presented as live.</p></div>
  </div> : <p class="empty-state">Published updates and upcoming milestones will appear here. No publication dates have been announced.</p>}
</SectionFrame>}
{section === 'latest-thought' && <SectionFrame page id="knowledge" label="the latest thought" note="a thought, fortnightly" heading={examples?.thought.title ?? thought?.data.title ?? 'Short thoughts. Space to think.'} example={!!examples}>
  {examples ? <article class="thought-body">
    <p class="large-copy">{examples.thought.excerpt}</p><p>{examples.thought.body}</p>
    <details><summary><span class="disclosure-icon" aria-hidden="true"></span>read the example thought</summary><p>The same song can be performed by different musicians, with different instruments, in different settings. It remains recognizable, but the sound changes. That is why knowledge needs to be designed for travel.</p><p class="meta">Excerpt from the kit’s example. Not an approved publication.</p></details>
  <a class="text-link" href="/design-preview/content/examples/knowledge-travels-like-a-song/">open the example thought →</a></article> : <><p class="large-copy">{thought?.data.description ?? 'Practical observations, reflections, and questions.'}</p>{thought ? <a class="text-link" href={entryPath(thought)}>read the thought →</a> : <p class="empty-state">The first thought will appear here once published.</p>}</>}
  <p class="section-more"><a class="text-link" href={`${prefix}/knowledge/`}>browse knowledge →</a></p>
</SectionFrame>}
{section === 'perspective' && <SectionFrame page id="perspective" label="a perspective" note="monthly, often unexpected" heading="A different way of seeing" example={!!examples}>
  {examples ? <article class="perspective-grid">
    <div class="perspective-art" role="img" aria-label="Typographic placeholder for a perspective; no artwork reproduced"><span class="meta">a perspective</span><span class="art-word">Cambio</span><span class="meta">a different way<br />of seeing</span></div>
    <div><p class="meta">design · an example from the kit</p><h2 class="feature-title">{examples.perspective.title}</h2><p>{examples.perspective.description}</p><aside class="why-note"><span class="meta">why it is here</span><p>{examples.perspective.why}</p></aside><a class="text-link" href="/design-preview/content/examples/cambio/">open the example perspective →</a></div>
  </article> : <><p>{perspective?.data.description ?? 'Perspectives from artists, thinkers, designers, scientists, authors, and other interesting sources.'}</p>{perspective ? <h2><a href={entryPath(perspective)}>{perspective.data.title}</a></h2> : <p class="empty-state">The first perspective will appear here once published.</p>}</>}
</SectionFrame>}
{section === 'unanswered-question' && <SectionFrame page id="unanswered-question" label="the unanswered question" note="room for another perspective" heading="Some questions are worth staying with" example={!!examples}>
  <div class="question-panel unanswered"><p class="meta">an open question</p><p class="question-text">{examples?.question ?? question?.data.title ?? 'No open question published yet.'}</p></div>
  {examples ? <p class="empty-state">Contribution forms and submissions are outside this design preview.</p> : !question && <p class="empty-state">An open question will appear here once published.</p>}
</SectionFrame>}
{section === 'participate' && <SectionFrame page id="participate" label="participate" note="knowledge grows together" heading="More perspectives. Better questions.">
  <p class="section-intro">Knowledge grows when more people work on it.</p>
  <ul class="participation-list">{ways.map((way, index) => <li><span class="meta" aria-hidden="true">0{index + 1}</span><span>{way}</span></li>)}</ul>
  <p class="empty-state">Ways to send contributions will be added in a later release.</p>
</SectionFrame>}
{section === 'about' && <SectionFrame page id="about-page" label="about" note="tolpagorni thoughts" heading="about the house"><p>tolpagorni thoughts is a knowledge house for practical, field-tested knowledge in technology-intensive businesses.</p><p class="meta">tolpagorni thoughts AB</p></SectionFrame>}
  </div>
</BaseLayout>
