---
interface Props { id: string; label: string; note: string; heading: string; example?: boolean; page?: boolean; }
const { id, label, note, heading, example = false, page = false } = Astro.props;
const Heading = page ? 'h1' : 'h2';
---
<section class="editorial-section" id={id} aria-labelledby={`${id}-title`}>
  <div class="section-grid wrap">
    <div class="section-label"><span>{label}</span><small>{note}</small></div>
    <div class="section-content">
      <div class="section-heading">
        <Heading id={`${id}-title`}>{heading}</Heading>
        {example && <span class="example-label">example · design only</span>}
      </div>
      <slot />
    </div>
  </div>
</section>
