---
interface Props { preview?: boolean; activeNav?: string; }
const { preview = false, activeNav } = Astro.props;
const prefix = preview ? '/design-preview' : '';
const home = preview ? '/design-preview' : '/';
const pathname = Astro.url.pathname.replace(/^\/design-preview/, '') || '/';
const inferred = /^\/(knowledge|library|thoughts|perspectives|questions)(\/|$)/.test(pathname) ? 'library'
  : /^\/(research|research-updates)(\/|$)/.test(pathname) ? 'research'
  : pathname.startsWith('/magnus-meets') ? 'magnus meets' : undefined;
const active = activeNav === 'knowledge' ? 'library' : activeNav ?? inferred;
const links = [
  { label: 'library', href: `${prefix}/library/` },
  { label: 'research', href: `${prefix}/research/` },
  { label: 'magnus meets', href: `${prefix}/magnus-meets/` },
  { label: 'participate', href: `${prefix}/participate/` },
  { label: 'about', href: `${prefix}/about/` },
];
---
<header class="site-header"><div class="wrap">
  <a class="identity" href={home} aria-label="tolpagorni thoughts — home">
    <img src="/assets/brand/tolpagorni-emblem.svg" width="44" height="44" alt="" />
  </a>
  <nav aria-label="Main navigation"><ul id="menu">{links.map(link => <li><a href={link.href} data-t={link.label} aria-label={link.label} style={`--len: ${link.label.length}ch`} aria-current={active === link.label ? (Astro.url.pathname.replace(/\/$/, '') === link.href.replace(/\/$/, '') ? 'page' : 'location') : undefined}>{link.label}</a></li>)}</ul></nav>
</div></header>
<script>
  import '../scripts/typewriter';
  const navigation = document.querySelector('nav[aria-label="Main navigation"]');
  const updateCurrentLink = () => {
    for (const link of navigation?.querySelectorAll<HTMLAnchorElement>('a') ?? []) {
      if (!link.hash) continue;
      const samePage = link.pathname.replace(/\/$/, '') === location.pathname.replace(/\/$/, '');
      if (samePage && link.hash === location.hash) link.setAttribute('aria-current', 'location');
      else link.removeAttribute('aria-current');
    }
  };
  updateCurrentLink();
  window.addEventListener('hashchange', updateCurrentLink);
</script>
