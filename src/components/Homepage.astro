---
import '../styles/homepage.css';
interface Props { preview?: boolean; }
const { preview = false } = Astro.props;
const prefix = preview ? '/design-preview' : '';
---
<div class="homepage">
<section class="entrance" aria-labelledby="entrance-title">
  <canvas id="sky" aria-hidden="true"></canvas>
  <div class="entrance-foreground" aria-hidden="true"></div>
  <div class="veil" aria-hidden="true"></div>
  <div class="wrap">
    <h1 id="entrance-title">thoughts need room to breathe</h1>
    <p class="purpose">A living space for practical thinking, exploration and knowledge development in technology-intensive businesses.</p>
    <a class="enter" href={`${prefix}/pulse/`}>enter <span aria-hidden="true">→</span></a>
  </div>
  <nav class="routes" aria-label="Direct routes">
    <span class="lh">or go straight to</span>
    <a href={`${prefix}/latest-thought/`}>the latest thought →</a>
    <a href={`${prefix}/research/`}>down the rabbit hole →</a>
    <a href={`${prefix}/unanswered-question/`}>the unanswered question →</a>
    <a href={`${prefix}/magnus-meets/`}>magnus meets →</a>
  </nav>
</section>

</div>

<script>
  import '../scripts/entrance';
</script>
