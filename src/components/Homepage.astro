---
import type { CollectionEntry } from 'astro:content';
import type { HomepageExample } from '../lib/homepage';
import SectionFrame from './SectionFrame.astro';
import { entryPath } from '../lib/editorial-routes';
interface Props { examples?: HomepageExample; entries?: CollectionEntry<'editorial'>[]; }
const { examples, entries = [] } = Astro.props;
const first = (kind: CollectionEntry<'editorial'>['data']['kind']) => entries.find(entry => entry.data.kind === kind);
const thought = first('thought');
const perspective = first('perspective');
const investigation = first('investigation');
const episode = first('episode');
const question = first('question');
const prefix = examples ? '/design-preview' : '';
const resources = entries.filter(entry => ['resource', 'publication'].includes(entry.data.kind));
const ways = ['Suggest a thought or an unanswered question', 'Recommend a perspective', 'Share a practical experience', 'Join an investigation', 'Review a developing publication', 'Suggest a guest for magnus meets'];
---
<section class="entrance" aria-labelledby="entrance-title">
  <div class="aurora" aria-hidden="true"></div>
  <img class="mountain" src="/assets/brand/mountain-lines.svg" width="1400" height="700" alt="" aria-hidden="true" fetchpriority="high" />
  <div class="wrap entrance-inner">
    <div class="entrance-copy">
      <p class="eyebrow">a house for practical thinking</p>
      <h1 id="entrance-title">thoughts need<br />room to breathe</h1>
      <p class="intro">A living space for practical thinking, exploration and knowledge development in technology-intensive businesses.</p>
      <a class="enter-link" href="#pulse">enter <span aria-hidden="true">↓</span></a>
    </div>
    <div class="direct-routes">
      <p class="meta">or follow a question</p>
      <a href="#knowledge">the latest thought <span aria-hidden="true">↗</span></a>
      <a href="#research">down the rabbit hole <span aria-hidden="true">↗</span></a>
      <a href="#unanswered-question">the unanswered question <span aria-hidden="true">↗</span></a>
    </div>
    <p class="entrance-caption meta">thoughts · exploration · knowledge</p>
  </div>
</section>

<SectionFrame id="pulse" label="the pulse" note="the rhythm of the house" heading="Always room for something developing">
  <p class="section-intro">What just happened, what is developing, what comes next.</p>
  <ul class="rhythm-strip" aria-label="The editorial rhythm">
    <li><span class="rhythm-mark" aria-hidden="true">·</span><span>a thought<small>fortnightly</small></span></li>
    <li><span class="rhythm-mark" aria-hidden="true">∧</span><span>a perspective<small>monthly</small></span></li>
    <li><span class="rhythm-mark" aria-hidden="true">⋀</span><span>an exploration<small>quarterly</small></span></li>
    <li><span class="rhythm-mark annual" aria-hidden="true">○</span><span>a publication<small>every August</small></span></li>
  </ul>
  {examples ? <div class="pulse-columns">
    <div><h3>just happened <span class="example-label">example</span></h3><p class="meta">a thought</p><p>{examples.thought.title}</p><p class="meta">a perspective</p><p>{examples.perspective.title}</p></div>
    <div><h3>developing now <span class="example-label">example</span></h3><p class="meta">down the rabbit hole</p><p>{examples.investigation.title}</p><p class="meta">an open question</p><p>{examples.question}</p></div>
    <div><h3>comes next</h3><p class="muted">Publication dates will appear here when approved.</p><p class="meta">No example schedule is presented as live.</p></div>
  </div> : <p class="empty-state">Published updates and upcoming milestones will appear here. No publication dates have been announced.</p>}
</SectionFrame>

<SectionFrame id="knowledge" label="the latest thought" note="a thought, fortnightly" heading={examples?.thought.title ?? thought?.data.title ?? 'Short thoughts. Space to think.'} example={!!examples}>
  {examples ? <article class="thought-body">
    <p class="large-copy">{examples.thought.excerpt}</p><p>{examples.thought.body}</p>
    <details><summary><span class="disclosure-icon" aria-hidden="true"></span>read the example thought</summary><p>The same song can be performed by different musicians, with different instruments, in different settings. It remains recognizable, but the sound changes. That is why knowledge needs to be designed for travel.</p><p class="meta">Excerpt from the kit’s example. Not an approved publication.</p></details>
  <a class="text-link" href="/design-preview/content/examples/knowledge-travels-like-a-song/">open the example thought →</a></article> : <><p class="large-copy">{thought?.data.description ?? 'Practical observations, reflections, and questions.'}</p>{thought ? <a class="text-link" href={entryPath(thought)}>read the thought →</a> : <p class="empty-state">The first thought will appear here once published.</p>}</>}
  <p class="section-more"><a class="text-link" href={`${prefix}/knowledge/`}>browse knowledge →</a></p>
</SectionFrame>

<SectionFrame id="perspective" label="a perspective" note="monthly, often unexpected" heading="A different way of seeing" example={!!examples}>
  {examples ? <article class="perspective-grid">
    <div class="perspective-art" role="img" aria-label="Typographic placeholder for a perspective; no artwork reproduced"><span class="meta">a perspective</span><span class="art-word">Cambio</span><span class="meta">a different way<br />of seeing</span></div>
    <div><p class="meta">design · an example from the kit</p><h3 class="feature-title">{examples.perspective.title}</h3><p>{examples.perspective.description}</p><aside class="why-note"><span class="meta">why it is here</span><p>{examples.perspective.why}</p></aside><a class="text-link" href="/design-preview/content/examples/cambio/">open the example perspective →</a></div>
  </article> : <><p>{perspective?.data.description ?? 'Perspectives from artists, thinkers, designers, scientists, authors, and other interesting sources.'}</p>{perspective ? <h3><a href={entryPath(perspective)}>{perspective.data.title}</a></h3> : <p class="empty-state">The first perspective will appear here once published.</p>}</>}
</SectionFrame>

<SectionFrame id="research" label="down the rabbit hole" note="one investigation, in depth" heading={examples?.investigation.title ?? investigation?.data.title ?? 'Follow a question further'} example={!!examples}>
  <div class="question-panel"><p class="meta">developing knowledge</p><p class="question-text">{examples?.investigation.question ?? investigation?.data.description ?? 'Room for questions, hypotheses, evidence, and emerging findings.'}</p></div>
  {examples ? <div class="research-bottom"><p>Background, hypotheses, materials, and findings — understanding made visible as it develops.</p><ol class="milestone-list" aria-label="Example milestones, not live progress">{examples.investigation.milestones.map((milestone, index) => <li><span class="milestone-number" aria-hidden="true">0{index + 1}</span><span>{milestone}</span><span class="meta">example</span></li>)}</ol></div> : !investigation && <p class="empty-state">Investigations and real milestones will appear here once published.</p>}
  <p class="section-more"><a class="text-link" href={examples ? "/design-preview/content/examples/replatforming/" : investigation ? entryPath(investigation) : "/research/"}>{examples || investigation ? "explore the investigation →" : "browse research →"}</a></p>
</SectionFrame>

<SectionFrame id="magnus-meets" label="magnus meets" note="conversations" heading="Interesting people. Open questions." example={!!examples}>
  {examples ? <article><div class="episode-frame"><span class="meta">magnus meets · example episode</span><p class="question-text">{examples.episode.question}</p><span class="episode-caption meta">a conversation, not a conclusion</span></div><div class="episode-copy"><h3 class="feature-title">{examples.episode.question}</h3><p>{examples.episode.intro}</p><details><summary><span class="disclosure-icon" aria-hidden="true"></span>selected observations · example</summary><ul>{examples.episode.observations.map(observation => <li>{observation}</li>)}</ul></details><p class="meta">Design placeholder. No video is available.</p></div></article> : <><p>{episode?.data.description ?? 'Conversations about products, technology, experiences, and different perspectives.'}</p>{episode ? <h3><a href={entryPath(episode)}>{episode.data.title}</a></h3> : <p class="empty-state">The first conversation will appear here once published.</p>}</>}
  <p class="section-more"><a class="text-link" href={examples ? "/design-preview/content/examples/what-should-never-be-replatformed/" : `${prefix}/magnus-meets/`}>{examples ? "open the example conversation →" : "all conversations →"}</a></p>
</SectionFrame>

<SectionFrame id="unanswered-question" label="the unanswered question" note="room for another perspective" heading="Some questions are worth staying with" example={!!examples}>
  <div class="question-panel unanswered"><p class="meta">an open question</p><p class="question-text">{examples?.question ?? question?.data.title ?? 'No open question published yet.'}</p></div>
  {examples ? <p class="empty-state">Contribution forms and submissions are outside this design preview.</p> : !question && <p class="empty-state">An open question will appear here once published.</p>}
</SectionFrame>

<SectionFrame id="library" label="from the library" note="established knowledge" heading="Knowledge to return to" example={!!examples}>
  <p class="section-intro">Publications, frameworks, tools, and practical resources.</p>
  {examples ? <ul class="library-shelf">{examples.library.map(book => <li><article><div class="book-cover"><span class="book-number">{book.number}</span><h3>{book.title}</h3><span class="meta">tolpagorni thoughts</span></div><p class="meta">{book.kind} · example</p><p>{book.description}</p></article></li>)}</ul> : resources.length ? <ul class="resource-list">{resources.map(resource => <li><h3><a href={entryPath(resource)}>{resource.data.title}</a></h3><p>{resource.data.description}</p></li>)}</ul> : <p class="empty-state">Approved resources will appear here once published.</p>}
  <p class="section-more"><a class="text-link" href={`${prefix}/library/`}>browse the library →</a></p>
  <p class="knowledge-path meta">thought <span aria-hidden="true">→</span> investigation <span aria-hidden="true">→</span> publication <span aria-hidden="true">→</span> library<span class="path-note">one possible path, not a required one</span></p>
</SectionFrame>

<SectionFrame id="participate" label="participate" note="knowledge grows together" heading="More perspectives. Better questions.">
  <p class="section-intro">Knowledge grows when more people work on it.</p>
  <ul class="participation-list">{ways.map((way, index) => <li><span class="meta" aria-hidden="true">0{index + 1}</span><span>{way}</span></li>)}</ul>
  <p class="empty-state">Ways to send contributions will be added in a later release.</p>
</SectionFrame>
